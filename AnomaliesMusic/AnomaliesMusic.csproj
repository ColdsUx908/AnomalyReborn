<Project Sdk="Microsoft.NET.Sdk">

    <Import Project="..\..\tModLoader.targets" />

    <PropertyGroup>
        <LangVersion>preview</LangVersion>
        <TargetFramework>net8.0</TargetFramework>
        <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
        <EnforceCodeStyleInBuild>True</EnforceCodeStyleInBuild>
		<!-- tModLoader loads the packaged DLL. Always run BuildMod before F5, even
             when a previous BuildMod=false build has already updated bin/obj. -->
		<DisableFastUpToDateCheck>true</DisableFastUpToDateCheck>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
        <NoWarn>1701;1702;649</NoWarn>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
        <NoWarn>1701;1702;649</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <Reference Include="CalamityMod">
            <HintPath>..\..\CalamityMod\CalamityMod.dll</HintPath>
        </Reference>
    </ItemGroup>

    <ItemGroup>
      <Folder Include="Music\" />
    </ItemGroup>

</Project>