AnomalyServerConfig: {
	DisplayName: Server Config
	Denied: You have no permission to change this config.
}

AnomalyClientConfig: {
	DisplayName: Client Config

	Headers: {
		Visuals: Visual Effects
		BaseBoosts: Base Stat Boosts
	}

	UseCalamityStyleTextures: {
		Label: Use Calamity-Style Textures
		Tooltip:
			'''
			Replace certain textures in the mod with versions that are more consistent with the art style of the Calamity Mod.
			It is recommended to use this in conjunction with Calamity Texture Pack.
			'''
	}

	EnableShaders: {
		Label: Enable Shaders
		Tooltip:
			'''
			Enables shaders for certain visual effects in the mod.
			Disabling this may improve performance, but will also make certain effects look worse.
			If you have visual or performance issues, disable this setting.
			Note: Shaders will be forcibly disabled regardless of this setting if "Lighting" is set to Retro or Trippy, or if "Wave Quality" is set to Off.
			'''
	}

	FasterBaseSpeed: {
		Label: Increase Base Movement Speed
		Tooltip:
			'''
			Increases the player's base movement speed substantially by always giving them +50% movement speed.
			Anomalies is balanced around this setting being enabled.
			If Calamity is enabled, consider using Calamity config instead.
			'''
	}

	FasterJumpSpeed: {
		Label: Increase Base Jump Speed
		Tooltip:
			'''
			Slightly increases the player's base jump speed.
			Anomalies is balanced around this setting being enabled.
			If Calamity is enabled, consider using Calamity config instead.
			'''
	}

	FasterFall: {
		Label: Enable Faster Falling
		Tooltip:
			'''
			When enabled, you can hold the {$Key.DOWN} key while in the air to accelerate downwards faster.
			This config does not increase your maximum falling speed, just how quickly you accelerate to it.
			Anomalies is balanced around this setting being enabled.
			If Calamity is enabled, consider using Calamity config instead.
			'''
	}

	FasterRopeClimbSpeed: {
		Label: Increase Rope Climb Speed
		Tooltip:
			'''
			Increases the player's rope climb speed substantially by increasing acceleration and deceleration while on a rope.
			Anomalies is balanced around this setting being enabled.
			If Calamity is enabled, consider using Calamity config instead.
			'''
	}

	FasterTilePlacement: {
		Label: "[i:ArchitectGizmoPack] Increase Base Building Speed"
		Tooltip:
			'''
			Substantially increases how rapidly the player can place tiles and walls.
			This config stacks with the Brick Layer, Portable Cement Mixer and other accessories.
			If Calamity is enabled, consider using Calamity config instead.
			'''
	}

	AllBaseBoosts: {
		Label: Enable All Base Stat Boosts
		Tooltip:
			'''
			Enables all base stat boosts.
			Anomalies is balanced around this setting being enabled.
			If Calamity is enabled, consider using Calamity config instead.
			'''
	}
}
