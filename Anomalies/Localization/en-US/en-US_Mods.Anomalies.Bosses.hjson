AnomalyMode: {
	Name: Anomaly
	ShortInfo: '''[c/FFCCFF:"Final challenge after transcending the abyss"]'''
	ExpandedInfo:
		'''
		[c/AFFFFF:Do you think you are worthy of transcending the gods?]
		[c/AFFFFF:If you crave a challenge beyond Death or Malice...]
		[c/00FFFF:Then...]
		'''
	Activate: Anomaly is active... are you serious?
	Deactivate: Anomaly is not active; wise choice.
	Invalid: Anomaly is only available in TRUE Master difficulty.
	UltraSuffix: "[c/FF0000:Ultramundane]"
	UltraInvalid_NotLegendary: Anomaly Ultramundane is only available in TRUE Legendary difficulty.
	UltraInvalid_Aromaly: You must cook fried rice in such a delicious mode!
	UltraActivate:
		'''
		Anomaly Ultramundane is fully activated, please make sure you know what you're doing!
		Note: This difficulty is extremely difficult and only suitable for ALIEN players!
		'''
	UltraDeactivate:
		'''
		Anomaly Ultramundane is back to normal...
		Did you try it?
		'''
	UltraInfo:
		'''
		[c/FF0000:ATTENTION]
		[c/FF0000:Anomaly Ultramundane is a special difficulty that is only available in TRUE Legendary difficulty.]
		[c/FF0000:This difficulty is extremely difficult and only suitable for ALIEN players!]
		[c/FF0000:Please make sure you know what you're doing before enjoying this difficulty!]
		'''

	Aromaly: {
		Name: Aromaly
		Activate: Aromaly is active! Your world is going to be delicious~
		Deactivate: Aromaly is not active. Don't you want something delicious?
	}
}

