<Project Sdk="Microsoft.NET.Sdk">

    <Import Project="..\..\tModLoader.targets" />

    <Import Project="AnomaliesModules.props" />

    <PropertyGroup>
        <LangVersion>preview</LangVersion>
        <TargetFramework>net8.0</TargetFramework>
        <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
        <EnforceCodeStyleInBuild>True</EnforceCodeStyleInBuild>
        <!-- tModLoader loads the packaged DLL. Always run BuildMod before F5, even
             when a previous BuildMod=false build has already updated bin/obj. -->
        <DisableFastUpToDateCheck>true</DisableFastUpToDateCheck>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
        <NoWarn>1701;1702;649</NoWarn>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
        <NoWarn>1701;1702;649</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\AnomaliesMusic\AnomaliesMusic.csproj" />
        <ProjectReference Include="..\Transoceanic\Transoceanic.csproj" />
        <ProjectReference Include="..\TransoceanicCodeAssist\TransoceanicCodeAssist.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    </ItemGroup>

    <ItemGroup>
      <Reference Include="CalamityMod">
        <HintPath>..\..\CalamityMod\CalamityMod.dll</HintPath>
      </Reference>
    </ItemGroup>

    <ItemGroup>
      <Folder Include="GameContents\MusicBoxes\" />
    </ItemGroup>

    <Target Name="PreBuild" BeforeTargets="PreBuildEvent">
	  <!--生成前自动调用着色器编译器。如果因为此编译器导致受阻，请自行禁用之-->
      <Exec Command="call &quot;$(ProjectDir)PreBuild\EffectCompiler\EffectCompiler.exe&quot;" />
    </Target>

</Project>