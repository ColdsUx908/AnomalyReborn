<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TmlTargets Condition="'$(TmlTargets)' == ''">../../../../tModLoader.targets</TmlTargets>
  </PropertyGroup>
  <Import Project="$(TmlTargets)" />
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>preview</LangVersion>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <BuildMod>false</BuildMod>
    <AutoHostingSource Condition="'$(AutoHostingSource)' == ''">../../../Transoceanic/Input/AutoHosting/AutoHosting.cs</AutoHostingSource>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(AutoHostingSource)" Link="AutoHosting.cs" />
    <Compile Include="$([System.IO.Path]::GetDirectoryName('$(AutoHostingSource)'))/AutoHostingInput.cs" Link="AutoHostingInput.cs" />
    <Compile Include="$([System.IO.Path]::GetDirectoryName('$(AutoHostingSource)'))/AutoHostingSystem.cs" Link="AutoHostingSystem.cs" />
    <Compile Include="Program.cs" />
    <Reference Include="$(tMLSteamPath)tModLoader.dll" Private="true" />
    <Reference Include="$(tMLLibraryPath)/FNA/1.0.0/FNA.dll" Private="true" />
  </ItemGroup>
</Project>
